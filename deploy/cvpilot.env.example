# Copy to /etc/cvpilot.env (sudo chmod 600) and fill in.
OPENROUTER_API_KEY=
MODEL_NAME=google/gemma-4-26b-a4b-it
# The app listens only locally; Caddy (deploy/Caddyfile.example) serves it
# to the internet over HTTPS.
CVPILOT_HOST=127.0.0.1
CVPILOT_PORT=8000
# Downloading from justjoin.it / rocketjobs.pl only with their written consent.
# Set to yes when you have it; until then the hourly job only drops expired offers.
OFFER_UPDATE_WRITTEN_CONSENT=no
