# Paths for the VPS where the project lives in /home/ubuntu/server/CVpilot.
# Another machine: change User, Group and every /home/ubuntu/server/CVpilot path.
[Unit]
Description=CVPilot offer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/server/CVpilot/server
EnvironmentFile=/etc/cvpilot-offer-server.env
# The virtual environment made by `uv sync`; no uv needed at run time.
ExecStart=/home/ubuntu/server/CVpilot/server/.venv/bin/python -m offer_server.app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
# The home folder is read-only for the service, except the server folder.
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/server/CVpilot/server
PrivateTmp=true

[Install]
WantedBy=multi-user.target
