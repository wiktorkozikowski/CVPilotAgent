# Copy to /etc/cvpilot-offer-server.env and set your own token.
OFFER_SERVER_HOST=0.0.0.0
OFFER_SERVER_PORT=8100
OFFER_SERVER_INDEX=/home/ubuntu/server/CVpilot/server/index
OFFER_SERVER_STORE=/home/ubuntu/server/CVpilot/server/store
OFFER_SERVER_MODEL_CACHE=/home/ubuntu/server/CVpilot/server/models_cache
OFFER_SERVER_TOKEN=change-me
# Downloading from justjoin.it / rocketjobs.pl only with their written consent.
# Set to yes when you have it; until then the hourly job only drops expired offers.
OFFER_UPDATE_WRITTEN_CONSENT=no
